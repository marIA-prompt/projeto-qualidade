# Copie para .env e preencha. NUNCA versione o .env.

# --- Supabase -----------------------------------------------------------
# Painel do projeto > Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# anon key: usada APENAS pelo dashboard (RLS ativo, usuário logado).
SUPABASE_ANON_KEY=

# Painel Next.js / Vercel (mesmo valor da anon key; exposto no browser de propósito).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key: usada APENAS pelo ETL (bypassa RLS, roda sem usuário).
# Nunca colocar no dashboard nem expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Fase 3 (ainda não usados na V1) -------------------------------------
# OpenAI: só para redigir narrativa de relatório / priorizar pré-auditoria.
# Nunca decide classificação regulatória.
# OPENAI_API_KEY=

# SMTP: mesma conta já usada no Thunderbird da área (sem ClickUp).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USUARIO=
# SMTP_SENHA=
# SMTP_REMETENTE=qualidade@senff.com.br

# --- Prévia local do painel (opcional; não versionar senha) ----------------
# DASHBOARD_PREVIEW_EMAIL=maria.morais@senff.com.br
# DASHBOARD_PREVIEW_PASSWORD=
# DASHBOARD_PREVIEW_AUTOLOGIN=0
# Em preview público (Streamlit Cloud) deixe AUTOLOGIN desligado.

# --- Hub de Agentes de Crédito (não usar o schema de CNPJ) ----------------
# Dados de agentes vêm de dados/preview/snapshot.json (ou Supabase NOVO).
# Nunca rode CREATE TABLE do produto de digitadores neste projeto
# (qzmssnbrmsokppgevxrr).
# NEXT_PUBLIC_DIGITADORES_URL=
