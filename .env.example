# Copie para `.env` e preencha com os valores reais (nunca commitar o .env
# preenchido). Em produção/CI, defina estas variáveis como secrets do
# ambiente (ex.: Cursor Cloud Agents > Secrets), nunca em texto puro no repo.

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Usada SOMENTE pelo ETL (etl/etl_reclamacoes.py, etl/calcular_classificacoes.py).
# Ignora RLS — nunca usar no dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Usada SOMENTE pelo dashboard Streamlit (dashboard/app.py). Respeita RLS,
# sempre associada a um usuário autenticado via Supabase Auth.
SUPABASE_ANON_KEY=

# --- OpenAI (opcional, Fase 3 — narrativa do relatório mensal) -------------
OPENAI_API_KEY=

# --- SMTP (reservado, Fase 3 — envio de e-mail de tratativa/relatório) -----
# Mesma conta já usada no Thunderbird da área (ver docs/decisoes.md, A5).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REMETENTE=
